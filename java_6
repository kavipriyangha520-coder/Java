import java.util.Scanner;
interface Bankaccount
{
void Deposit();
void Withdraw();
void Balance();
}
class Operation implements Bankaccount
{
String actname;
int actnum;
double inbalance=5000,deposit,withdraw;
public void Deposit()
{
inbalance=inbalance+deposit;
System.out.println("Amount Deposited Successfully......");
System.out.println("Available Balance:Rs."+inbalance);
}
public void Withdraw()
{
if(inbalance<withdraw)
{
throw new ArithmeticException("Insufficient balance to withdraw......");
}
else
{
inbalance=inbalance-withdraw;
System.out.println("Withdraw happend successfully......");
System.out.println("Available Balance:Rs."+inbalance);
}
}
public void Balance()
{
System.out.println("Available Balance:Rs."+inbalance);
if(inbalance==0)
{
System.out.println("Insufficient balance! Mainatain Balance");
}
}
}
class Pay
{
public static void main(String args[])
{
Scanner s=new Scanner(System.in);
Operation o=new Operation();
System.out.println("...............Account Details.............");
System.out.println("Account Holder Name:");
o.actname=s.nextLine();
System.out.println("Account Number:");
o.actnum=s.nextInt();
s.nextLine();
System.out.println("Intial Balance:"+o.inbalance);
System.out.println("...........................................");
int choice;
do
{
System.out.println("........Choices.......");
System.out.println("1,Deposit");
System.out.println("2,Withdraw");
System.out.println("3,Balance");
System.out.println("4,Exit");
System.out.println(".....................");
System.out.println("Enter Your Choice:");
choice=s.nextInt();
try
{
if(choice==1)
{
System.out.println("Enter Deposit Amount:");
o.deposit=s.nextDouble();
s.nextLine();
o.Deposit();
}
else if(choice==2)
{
System.out.println("Enter Withdraw Amount:");
o.withdraw=s.nextDouble();
s.nextLine();
o.Withdraw();
}
else if(choice==3)
{
o.Balance();
}
else if(choice==4)
{
System.out.println("Exit........");
break;
}
}
catch(ArithmeticException e)
{
System.out.println("Error Try Again:"+e.getMessage());
}
finally
{
System.out.println("......Thankyou!.......");
}
}while (true);
}
}